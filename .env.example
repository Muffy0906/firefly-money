# Copy this file to .env and fill it in, then run: docker compose up -d

# How the container reaches Firefly III (container name, LAN IP or URL). No trailing slash.
# Also used for the sidebar's "Open Firefly III" link, so a LAN address works best.
FIREFLY_URL=http://192.168.1.20:8080

# A Firefly III Personal Access Token (Options → Profile → OAuth → Personal access tokens).
# It stays inside the container; the browser never sees it.
FIREFLY_TOKEN=

# The password for the Money sign-in screen. Use something long, and don't start it with "~".
DASH_PASSWORD=

# Port on the host (optional, default 8090).
MONEY_PORT=8090
