# Sign-in sessions (app/session.js): $money_session is "1" for a request with a valid session cookie, and
# $money_renew is a fresh cookie when the current one is getting old.
js_path /etc/nginx/money;
js_import session from session.js;
js_set $money_session session.check;
js_set $money_renew session.renew;
# Apple Pay auto-logging (app/ingest.js)
js_import ingest from ingest.js;

# Rate limits, per client address. Sign-in attempts: 10 a minute, after a first 5 straight away. API calls:
# 50 a second with room for bursts of 500, far more than the app sends, so it only stops floods. Behind a
# reverse proxy every client shares the proxy's address, so these limits are shared too.
limit_req_zone $binary_remote_addr zone=signin:1m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:2m rate=50r/s;
# Payments from the Apple Pay shortcut: 20 a minute is plenty for real taps and stops anyone guessing the key.
limit_req_zone $binary_remote_addr zone=ingest:1m rate=20r/m;
limit_req_status 429;

# The page links the stylesheet and scripts with ?v=<build version>, and each build gets a new
# version, so a versioned URL never changes content: browsers may keep it for a year without asking
# again. Without a version (a local build has no stamp), they check with the server on every use.
map $arg_v $asset_cache {
    default "public, max-age=31536000, immutable";
    ""      "no-cache";
}

# Logos for payees and accounts (see /logo/ below), kept for a month
proxy_cache_path /var/cache/nginx/logos levels=1:2 keys_zone=logos:2m max_size=50m inactive=30d use_temp_path=off;
# Map pictures for the Map page (see /tile/ below), kept for a month
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:4m max_size=300m inactive=60d use_temp_path=off;

server {
    listen ${LISTEN_PORT};

    # Compress the page and API responses (much faster over Wi-Fi)
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/vnd.api+json text/csv application/javascript text/css image/svg+xml application/manifest+json;


    # Installable app: manifest, icon and a service worker that keeps the app's own files (never your Firefly data)
    location = /manifest.webmanifest { default_type application/manifest+json; return 200 '{"name":"Money","short_name":"Money","start_url":"/","scope":"/","display":"standalone","background_color":"#161618","theme_color":"#161618","icons":[{"src":"/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any"},{"src":"/icon.svg","sizes":"512x512","type":"image/svg+xml","purpose":"maskable"}]}'; }
    location = /icon.svg { default_type image/svg+xml; add_header Cache-Control "max-age=86400"; return 200 '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180"><rect width="180" height="180" rx="40" fill="#1f1f23"/><path d="M38 122l36-36 24 24 44-46M112 62h32v32" fill="none" stroke="#39ff9f" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/></svg>'; }
    location = /sw.js { default_type application/javascript; add_header Cache-Control "no-cache"; return 200 'const C="money-v1",N="/__money-updated";self.addEventListener("install",e=>{self.skipWaiting();e.waitUntil(caches.open(C).then(c=>fetch("/").then(res=>{if(res.ok){c.put("/",res.clone());return keep(c,res)}})))});self.addEventListener("activate",e=>e.waitUntil(Promise.all([self.clients.claim(),caches.open(C).then(c=>c.keys().then(ks=>Promise.all(ks.filter(k=>new URL(k.url).pathname.startsWith("/api/")).map(k=>c.delete(k)))))])));const ver=r=>r&&(r.headers.get("etag")||r.headers.get("last-modified"));const keep=(c,res)=>res.text().then(h=>Promise.all(h.split(String.fromCharCode(34)).filter(x=>x.startsWith("/assets/")).map(x=>c.match(x).then(m=>m||c.add(x)).catch(()=>{})))).catch(()=>{});self.addEventListener("fetch",e=>{const r=e.request;if(r.method!=="GET")return;const u=new URL(r.url);if(u.origin!==location.origin)return;if(r.mode==="navigate"){e.respondWith(caches.open(C).then(c=>Promise.all([c.match("/"),c.match(N)]).then(([old,note])=>{const net=fetch(r).then(res=>{if(res.ok){const v=ver(res);c.put("/",res.clone());keep(c,res.clone());if(old&&v&&ver(old)!==v){c.put(N,new Response(v));self.clients.matchAll({includeUncontrolled:true,type:"window"}).then(cs=>cs.forEach(x=>x.postMessage("money-updated")))}}return res});if(!old)return net.catch(()=>new Response("Offline",{status:503}));e.waitUntil(net.catch(()=>{}).then(()=>note&&note.text().then(t=>{if(t===ver(old))return c.delete(N)})));return old})));return}if(u.pathname.startsWith("/assets/")){e.respondWith(caches.open(C).then(c=>c.match(r).then(m=>{const net=fetch(r).then(res=>{if(res.ok)c.put(r,res.clone());return res});if(m){e.waitUntil(net.catch(()=>{}));return m}return net})));return}});'; }

    # The app's stylesheet and scripts (cached as $asset_cache above says)
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control $asset_cache;
        add_header X-Content-Type-Options "nosniff";
    }

    # Logos for payees and accounts (app/src/core/logo.ts). This server fetches each website's icon from
    # DuckDuckGo's icon service and caches it, so the browser never contacts another site and the service
    # only sees this server. No password: <img> can't send one, and an icon reveals nothing. A domain
    # without an icon answers a plain 404, and the app shows the monogram instead.
    location ~ "^/logo/(?<logo>[a-z0-9][a-z0-9.-]{0,62}\.[a-z]{2,12})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $icons "https://icons.duckduckgo.com/ip3/";
        proxy_pass $icons$logo.ico;
        proxy_ssl_server_name on;
        proxy_set_header Host icons.duckduckgo.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header User-Agent "Money";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache logos;
        proxy_cache_valid 200 30d;
        proxy_cache_valid any 1d;
        proxy_cache_use_stale error timeout updating;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 400 403 404 410 500 502 503 504 =404 @nologo;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
    }
    # Map pictures for the Map page (app/src/pages/map.ts), from OpenStreetMap's tile server. This server fetches and
    # keeps them, so the browser never contacts another site, and OpenStreetMap only sees this server (as their
    # tile policy asks: a clear User-Agent, and no tile fetched again for at least a week). Only zoom 0-19.
    location ~ "^/tile/(?<tz>1?[0-9])/(?<tx>[0-9]{1,6})/(?<ty>[0-9]{1,6})\.png$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $osm "https://tile.openstreetmap.org/";
        proxy_pass $osm$tz/$tx/$ty.png;
        proxy_ssl_server_name on;
        proxy_set_header Host tile.openstreetmap.org;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 30d;
        proxy_cache_valid any 10m;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
    }

    location @nologo { add_header Cache-Control "public, max-age=86400"; return 404; }

    # The app page. Mounted as a template so nginx copies it at startup,
    # which avoids file-permission problems on TrueNAS. Only index.html is ever served.
    location / {
        root /etc/nginx/conf.d;
        default_type text/html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "no-referrer";
        # Only this server may supply scripts, styles, images and API calls, and no other site may frame the page.
        # No inline script either (markup handlers are data-on* attributes, see assets/js/events.js).
        # Styles stay 'unsafe-inline' for the style="" attributes; CSS can't run script.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
        add_header X-Frame-Options "DENY";
        add_header Cross-Origin-Opener-Policy "same-origin";
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()";
        try_files /index.html =404;
    }

    # Signing in and out (POST and DELETE, see app/session.js)
    location = /api/money-session {
        limit_req zone=signin burst=5 nodelay;
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        js_content session.endpoint;
    }

    # Payments from the Apple Pay shortcut (POST, with the key from Settings), and that key (GET, signed in).
    # See app/ingest.js and docs/apple-pay.md.
    location = /api/money-ingest {
        limit_req zone=ingest burst=10 nodelay;
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        js_content ingest.endpoint;
    }
    # Where ingest.js reaches Firefly: only nginx itself can use this (internal), never a browser.
    location ~ ^/__firefly(?<ffpath>/api/v1/.*)$ {
        internal;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $firefly "${FIREFLY_URL}";
        proxy_pass $firefly$ffpath$is_args$args;
        proxy_set_header Authorization "Bearer ${FIREFLY_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header Accept "application/vnd.api+json";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 30s;
        # ingest.js reads the whole answer (a list of up to 500 accounts)
        subrequest_output_buffer_size 4m;
    }

    # "Is Money itself there?" (features/ffstatus.ts). When the Firefly ping fails, the app asks this to tell a
    # Firefly that's down from a Money that's down: a reverse proxy in front of a stopped Money answers 502/504 or
    # hangs, just like nginx here does for a stopped Firefly, but only Money answers this one with its header.
    location = /api/money-alive {
        add_header X-Money-Server "1" always;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    # Proxy to Firefly III. Requires a session; the Firefly token never leaves the server.
    # The page also sends an X-Money header with each call: another site can't add one to a request without
    # asking first (CORS), so a page elsewhere (even another app on this server) can't use your session.
    location /api/ {
        if ($money_session = "") { add_header X-Dash-Auth required always; return 401; }
        if ($http_x_money = "")  { return 403; }
        limit_req zone=api burst=500 nodelay;
        # Keeps the session going while the app is in use (no header when nothing is due)
        add_header Set-Cookie $money_renew;

        limit_except GET POST PUT DELETE { deny all; }
        # Through a variable, so nginx looks up Firefly's address per request instead of once at
        # startup: Money starts even when Firefly is down or its name doesn't resolve yet.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $firefly "${FIREFLY_URL}";
        proxy_pass $firefly$request_uri;
        proxy_set_header Authorization "Bearer ${FIREFLY_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header X-Money "";
        proxy_set_header Accept "application/vnd.api+json";
        proxy_hide_header Set-Cookie;
        proxy_read_timeout 60s;
        client_max_body_size 50m;
    }
}
