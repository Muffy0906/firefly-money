# Sign-in sessions (app/session.js): $money_session is "1" for a request with a valid session cookie, and
# $money_renew is a fresh cookie when the current one is getting old.
js_path /etc/nginx/money;
js_import session from session.js;
js_set $money_session session.check;
js_set $money_renew session.renew;
# Apple Pay auto-logging (app/ingest.js)
js_import ingest from ingest.js;
# Most-used pages (app/pages.js): counts shared by the workers, saved to MONEY_DATA (default /data)
js_import pages from pages.js;
js_shared_dict_zone zone=money_pages:64k type=number;

# Rate limits, per client address. Sign-in attempts: 6 a minute. API calls:
# 50 a second with room for bursts of 500, far more than the app sends, so it only stops floods. Behind a
# reverse proxy every client shares the proxy's address, so these limits are shared too.
limit_req_zone $binary_remote_addr zone=signin:1m rate=6r/m;
limit_req_zone $binary_remote_addr zone=api:2m rate=50r/s;
# Logos, map tiles and place lookups need no sign-in and are fetched from other servers: their own slower limit, so an open install can't be used as a relay
limit_req_zone $binary_remote_addr zone=relay:2m rate=15r/s;
# Payments from the Apple Pay shortcut: 20 a minute is plenty for real taps and stops anyone guessing the key.
limit_req_zone $binary_remote_addr zone=ingest:1m rate=20r/m;
# Page visits (a few a minute in real use)
limit_req_zone $binary_remote_addr zone=pages:1m rate=60r/m;
limit_req_status 429;

# The page links the stylesheet and scripts with ?v=<build version>, and each build gets a new
# version, so a versioned URL never changes content: browsers may keep it for a year without asking
# again. Without a version (a local build has no stamp), they check with the server on every use.
map $arg_v $asset_cache {
    default "public, max-age=31536000, immutable";
    ""      "no-cache";
}

# Logos for payees and accounts (see /logo/ below), kept for a month
proxy_cache_path /var/cache/nginx/logos levels=1:2 keys_zone=logos:2m max_size=50m inactive=30d use_temp_path=off;
# Map pictures for the Map page (see /tile/ below), kept for a month
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:4m max_size=300m inactive=60d use_temp_path=off;

server {
    listen ${LISTEN_PORT};

    # Compress the page and API responses (much faster over Wi-Fi)
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/vnd.api+json text/csv application/javascript text/css image/svg+xml application/manifest+json;


    # Installable app: manifest, icon and a service worker that keeps the app's own files (never your Firefly data)
    location = /manifest.webmanifest { default_type application/manifest+json; return 200 '{"name":"Money","short_name":"Money","start_url":"/","scope":"/","display":"standalone","background_color":"#161618","theme_color":"#161618","icons":[{"src":"/assets/icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/assets/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any"},{"src":"/icon.svg","sizes":"512x512","type":"image/svg+xml","purpose":"maskable"}]}'; }
    location = /icon.svg { default_type image/svg+xml; add_header Cache-Control "max-age=86400"; return 200 '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180"><rect width="180" height="180" rx="40" fill="#1f1f23"/><path d="M38 122l36-36 24 24 44-46M112 62h32v32" fill="none" stroke="#39ff9f" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"/></svg>'; }
    location = /sw.js { default_type application/javascript; add_header Cache-Control "no-cache"; return 200 'const C="money-v1",N="/__money-updated";self.addEventListener("install",e=>{self.skipWaiting();e.waitUntil(caches.open(C).then(c=>fetch("/").then(res=>{if(res.ok){c.put("/",res.clone());return keep(c,res)}})))});self.addEventListener("activate",e=>e.waitUntil(Promise.all([self.clients.claim(),caches.open(C).then(c=>c.keys().then(ks=>Promise.all(ks.filter(k=>new URL(k.url).pathname.startsWith("/api/")).map(k=>c.delete(k)))))])));const ver=r=>r&&(r.headers.get("etag")||r.headers.get("last-modified"));const keep=(c,res)=>res.text().then(h=>Promise.all(h.split(String.fromCharCode(34)).filter(x=>x.startsWith("/assets/")).map(x=>c.match(x).then(m=>m||c.add(x)).catch(()=>{})))).catch(()=>{});self.addEventListener("fetch",e=>{const r=e.request;if(r.method!=="GET")return;const u=new URL(r.url);if(u.origin!==location.origin)return;if(r.mode==="navigate"){if(u.pathname!=="/")return;e.respondWith(caches.open(C).then(c=>Promise.all([c.match("/"),c.match(N)]).then(([old,note])=>{const net=fetch(r).then(res=>{if(res.ok){const v=ver(res);c.put("/",res.clone());keep(c,res.clone());if(old&&v&&ver(old)!==v){c.put(N,new Response(v));self.clients.matchAll({includeUncontrolled:true,type:"window"}).then(cs=>cs.forEach(x=>x.postMessage("money-updated")))}}return res});if(!old)return net.catch(()=>new Response("Offline",{status:503}));e.waitUntil(net.catch(()=>{}).then(()=>note&&note.text().then(t=>{if(t===ver(old))return c.delete(N)})));return old})));return}if(u.pathname.startsWith("/assets/")){e.respondWith(caches.open(C).then(c=>c.match(r).then(m=>{const net=fetch(r).then(res=>{if(res.ok)c.put(r,res.clone());return res});if(m){e.waitUntil(net.catch(()=>{}));return m}return net})));return}});'; }

    # The app's stylesheet and scripts (cached as $asset_cache above says)
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control $asset_cache;
        add_header X-Content-Type-Options "nosniff";
    }

    # Logos for payees and accounts (app/src/core/logo.ts). This server fetches each website's icon from
    # DuckDuckGo's icon service and caches it, so the browser never contacts another site and the service
    # only sees this server. No password: <img> can't send one, and an icon reveals nothing. A domain
    # without an icon answers a plain 404, and the app shows the monogram instead.
    location ~ "^/logo/(?<logo>[a-z0-9][a-z0-9.-]{0,62}\.[a-z]{2,12})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $icons "https://icons.duckduckgo.com/ip3/";
        proxy_pass $icons$logo.ico;
        proxy_ssl_server_name on;
        proxy_set_header Host icons.duckduckgo.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header User-Agent "Money";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache logos;
        proxy_cache_valid 200 30d;
        proxy_cache_valid any 1d;
        proxy_cache_use_stale error timeout updating;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 400 403 404 410 500 502 503 504 =404 @nologo;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        # No password here, so cap the rate: stops anyone using this server as a free icon or map-tile relay
        limit_req zone=relay burst=100 nodelay;
    }
    # Map pictures for the Map page (app/src/pages/map.ts), from OpenStreetMap's tile server. This server fetches and
    # keeps them, so the browser never contacts another site, and OpenStreetMap only sees this server (as their
    # tile policy asks: a clear User-Agent, and no tile fetched again for at least a week). Only zoom 0-19.
    location ~ "^/tile/(?<tz>1?[0-9])/(?<tx>[0-9]{1,6})/(?<ty>[0-9]{1,6})\.png$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $osm "https://tile.openstreetmap.org/";
        proxy_pass $osm$tz/$tx/$ty.png;
        proxy_ssl_server_name on;
        proxy_set_header Host tile.openstreetmap.org;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 30d;
        proxy_cache_valid any 10m;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=100 nodelay;
    }
    # Store lookup for the Map page (app/src/features/stores.ts), only when switched on there: finds a chain's store by
    # its number in OpenStreetMap (Overpass). The query is built here from just the chain pattern and number in the
    # path (letters, digits and dots only), so this can't be used to send OpenStreetMap anything else. Kept for a month.
    location ~ "^/osm/(?<ob>[a-z0-9.]{2,30})/(?<on>[0-9]{1,6})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $ov "https://overpass-api.de/api/interpreter?data=%5Bout:json%5D%5Btimeout:15%5D;%28nwr%5B%22brand%22~%22$ob%22,i%5D%5B%22ref%22~%22%5E0*$on%24%22%5D;nwr%5B%22name%22~%22$ob%22,i%5D%5B%22ref%22~%22%5E0*$on%24%22%5D;%29;out%20center%208;";
        proxy_pass $ov;
        proxy_ssl_server_name on;
        proxy_set_header Host overpass-api.de;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 30d;
        proxy_cache_valid any 1m;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=20 nodelay;
    }

    # Weather for the Interstellar theme's sky (app/src/core/sky.ts), only if you turn on Live weather in Settings. Same idea
    # as the rates below: this server asks Open-Meteo (no key), so the browser never contacts another site and Open-Meteo
    # only sees this server, never your device. The place is whatever your browser sent, already rounded to one decimal
    # (about 10 km); only that shape fits the path. Kept 15 minutes.
    location ~ "^/wx/(?<wxla>-?[0-9]{1,2}\.[0-9])/(?<wxlo>-?[0-9]{1,3}\.[0-9])$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $wxu "https://api.open-meteo.com/v1/forecast?latitude=$wxla&longitude=$wxlo&current=weather_code";
        proxy_pass $wxu;
        proxy_ssl_server_name on;
        proxy_set_header Host api.open-meteo.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header Accept "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 15m;
        proxy_cache_valid any 1m;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=20 nodelay;
    }

    # Place search for the Interstellar theme's sky (Settings > Appearance): turns a typed city or postcode into a place and
    # its coordinates. Same idea as /wx: this server asks Open-Meteo's geocoder (no key), so the browser never contacts
    # another site. Only the typed words (letters, digits and a few marks, kept short) and en or es go upstream.
    location = /geo {
        if ($arg_q !~ "^[A-Za-z0-9%+._,'-]{2,120}$") { return 400; }
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $geol en;
        if ($arg_l = es) { set $geol es; }
        if ($arg_l = de) { set $geol de; }
        set $geou "https://geocoding-api.open-meteo.com/v1/search?name=$arg_q&count=6&language=$geol&format=json";
        proxy_pass $geou;
        proxy_ssl_server_name on;
        proxy_set_header Host geocoding-api.open-meteo.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header Accept "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 1d;
        proxy_cache_valid any 1m;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=20 nodelay;
    }

    # Exchange rates for accounts in another currency (app/src/core/fx.ts). This server asks, so the browser never
    # contacts another site (the page's connect-src stays 'self') and the services only see this server. Neither
    # needs a key. /fx/a is Frankfurter (the European Central Bank's daily rates) for just the currencies asked for;
    # /fx/b is open.er-api.com, used for a currency Frankfurter doesn't have or when it can't be reached. Only
    # three-letter codes fit in the path, so nothing else can be sent on. Kept 15 minutes: the rates change once a day.
    location ~ "^/fx/a/(?<fxb>[A-Z]{3})/(?<fxs>[A-Z]{3}(,[A-Z]{3}){0,39})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $fxa "https://api.frankfurter.dev/v1/latest?base=$fxb&symbols=$fxs";
        proxy_pass $fxa;
        proxy_ssl_server_name on;
        proxy_set_header Host api.frankfurter.dev;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header Accept "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 15m;
        proxy_cache_valid any 1m;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=20 nodelay;
    }
    location ~ "^/fx/b/(?<fxb>[A-Z]{3})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s;
        resolver_timeout 5s;
        set $fxo "https://open.er-api.com/v6/latest/";
        proxy_pass $fxo$fxb;
        proxy_ssl_server_name on;
        proxy_set_header Host open.er-api.com;
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Authorization "";
        proxy_set_header Accept "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_set_header User-Agent "Money/1 (self-hosted Firefly III frontend; +https://github.com/Muffy0906/firefly-money)";
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_cache tiles;
        proxy_cache_valid 200 15m;
        proxy_cache_valid any 1m;
        proxy_cache_lock on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff";
        limit_except GET { deny all; }
        limit_req zone=relay burst=20 nodelay;
    }

    location @nologo { add_header Cache-Control "public, max-age=86400"; return 404; }

    # Static pages: privacy, the 404 page and robots.txt. Public, no data. Copied at startup like index.html.
    location = /privacy.html {
        root /etc/nginx/conf.d;
        default_type text/html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header X-Frame-Options "DENY";
    }
    location = /404.html { internal; root /etc/nginx/conf.d; default_type text/html; add_header X-Content-Type-Options "nosniff"; }
    # A private app: ask search engines to stay out
    location = /robots.txt { default_type text/plain; add_header Cache-Control "max-age=86400"; return 200 "User-agent: *\nDisallow: /\n"; }
    error_page 404 /404.html;

    # The app page. Mounted as a template so nginx copies it at startup,
    # which avoids file-permission problems on TrueNAS. Only index.html is ever served.
    location / {
        root /etc/nginx/conf.d;
        default_type text/html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "no-referrer";
        # Only this server may supply scripts, styles, images and API calls, and no other site may frame the page.
        # No inline script either (markup handlers are data-on* attributes, see assets/js/events.js).
        # Styles stay 'unsafe-inline' for the style="" attributes; CSS can't run script.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
        add_header X-Frame-Options "DENY";
        add_header Cross-Origin-Opener-Policy "same-origin";
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()";
        try_files /index.html =404;
    }

    # Signing in and out (POST and DELETE, see app/session.js)
    location = /api/money-session {
        limit_req zone=signin burst=5 nodelay;
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        js_content session.endpoint;
    }

    # Payments from the Apple Pay shortcut (POST, with the key from Settings), and that key (GET, signed in).
    # See app/ingest.js and docs/apple-pay.md.
    location = /api/money-ingest {
        limit_req zone=ingest burst=10 nodelay;
        client_max_body_size 4k;
        client_body_buffer_size 4k;
        js_content ingest.endpoint;
    }
    # Which pages you use most, so the app can load them ahead on any device (GET the top ones, POST a visit, DELETE to
    # forget). Page names and counts only. See app/pages.js.
    location = /api/money-pages {
        if ($money_session = "") { add_header X-Dash-Auth required always; return 401; }
        if ($http_x_money = "")  { return 403; }
        limit_req zone=pages burst=30 nodelay;
        client_max_body_size 1k;
        client_body_buffer_size 1k;
        js_content pages.endpoint;
    }
    # Where ingest.js reaches Firefly: only nginx itself can use this (internal), never a browser.
    location ~ ^/__firefly(?<ffpath>/api/v1/.*)$ {
        internal;
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $firefly "${FIREFLY_URL}";
        proxy_pass $firefly$ffpath$is_args$args;
        proxy_set_header Authorization "Bearer ${FIREFLY_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header Accept "application/vnd.api+json";
        proxy_set_header Content-Type "application/json";
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 30s;
        # ingest.js reads the whole answer (a list of up to 500 accounts)
        subrequest_output_buffer_size 4m;
    }

    # "Is Money itself there?" (features/ffstatus.ts). When the Firefly ping fails, the app asks this to tell a
    # Firefly that's down from a Money that's down: a reverse proxy in front of a stopped Money answers 502/504 or
    # hangs, just like nginx here does for a stopped Firefly, but only Money answers this one with its header.
    location = /api/money-alive {
        add_header X-Money-Server "1" always;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    # Proxy to Firefly III. Requires a session; the Firefly token never leaves the server.
    # The page also sends an X-Money header with each call: another site can't add one to a request without
    # asking first (CORS), so a page elsewhere (even another app on this server) can't use your session.
    location /api/ {
        if ($money_session = "") { add_header X-Dash-Auth required always; return 401; }
        if ($http_x_money = "")  { return 403; }
        limit_req zone=api burst=500 nodelay;
        # Keeps the session going while the app is in use (no header when nothing is due)
        add_header Set-Cookie $money_renew;

        limit_except GET POST PUT DELETE { deny all; }
        # Through a variable, so nginx looks up Firefly's address per request instead of once at
        # startup: Money starts even when Firefly is down or its name doesn't resolve yet.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $firefly "${FIREFLY_URL}";
        proxy_pass $firefly$request_uri;
        proxy_set_header Authorization "Bearer ${FIREFLY_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header X-Money "";
        proxy_set_header Accept "application/vnd.api+json";
        proxy_hide_header Set-Cookie;
        proxy_read_timeout 60s;
        client_max_body_size 50m;
    }
}
